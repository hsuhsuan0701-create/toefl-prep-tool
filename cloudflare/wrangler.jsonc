{
  // Run from the repository root: npx wrangler deploy --config cloudflare/wrangler.jsonc
  "name": "toefl-prep-private",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 1 * * *"] },
  "vars": { "AI_GENERATION_ENABLED": "false", "GEMINI_MODEL": "gemini-3.1-flash-lite" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toefl-prep-private",
      "database_id": "7d6aa5f0-eea3-4657-9238-e31e3a04af82",
      "migrations_dir": "migrations"
    }
  ]
}
