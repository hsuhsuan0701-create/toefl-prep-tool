# Copy to .env (never commit it). Every setting the server reads is listed here, with its default.
# Commented-out lines show the default and can stay commented. Nothing here is needed to start the
# app: Reading and Listening practice works with every line blank. The in-app Setup checklist (and
# GET /api/setup-status) says which feature each missing piece turns off.

# --- API keys --------------------------------------------------------------------------------------
# Gemini: Speaking transcription (Ears), the Gemini Judges, text-to-speech for new Speaking and
# Listening Sets, and locating focus regions in Speaking scene images.
GEMINI_API_KEY=
# OpenAI: the OpenAI speaking Judge (audio), the OpenAI essay Judge when Codex is unavailable or
# OPENAI_TEXT_PRIMARY=http, and scene images for new Speaking Sets.
OPENAI_API_KEY=

# --- Judge models ----------------------------------------------------------------------------------
# Required for scoring Speaking and Writing; the values below are the recommended flagship text tiers.
# GEMINI_JUDGE_MODEL also runs Ears and scene-image focus regions. OPENAI_JUDGE_MODEL is the HTTP
# model for the OpenAI essay Judge; keep it set even when Codex judges first.
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview
OPENAI_JUDGE_MODEL=gpt-5.5-2026-04-23
# The OpenAI speaking Judge's audio-input model.
# OPENAI_AUDIO_JUDGE_MODEL=gpt-audio-1.5

# --- Reasoning CLIs --------------------------------------------------------------------------------
# Set generation and the Arbiter run on the Claude CLI, then the Codex CLI. Neither is needed to start.
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# Pin the Claude CLI's model and effort. Both are unset by default, which leaves `claude -p` on
# whatever your interactive session last saved; pin both wherever that may be slow. Leave a line
# commented rather than blank: a blank value fails boot. CLAUDE_CLI_EFFORT allows: low, medium,
# high, xhigh, max. (The lines below are examples, not defaults.)
# CLAUDE_CLI_MODEL=<a Claude model id>
# CLAUDE_CLI_EFFORT=medium
# CODEX_REASONING_EFFORT allows: low, medium, high, xhigh, max, ultra.
# CODEX_MODEL=gpt-5.6-sol
# CODEX_REASONING_EFFORT=high
# Who judges essays for the OpenAI family: codex = Codex CLI, then OpenAI HTTP; http = HTTP only,
# never starting Codex.
# OPENAI_TEXT_PRIMARY=codex

# --- Reasoning budgets and admission ---------------------------------------------------------------
# Time for one CLI call after it is admitted, including one structured-output repair. Scoring is the
# Arbiter; generation is plan, generate, verify and import. Claude's generation budget is lower than
# Codex's on purpose: it gives up on a slow Claude call sooner and leaves time for the Codex fallback.
# CLAUDE_ROUTE_TIMEOUT_MS=750000
# CODEX_ROUTE_TIMEOUT_MS=300000
# CLAUDE_GENERATION_ROUTE_TIMEOUT_MS=750000
# CODEX_GENERATION_ROUTE_TIMEOUT_MS=900000
# How many calls each CLI runs at once, and how many slots stay reserved for scoring. Must satisfy
# 1 <= reserve < floor <= initial <= ceiling <= 8. Setting only a provider's ceiling to 1 runs that
# provider one call at a time.
# CLAUDE_REASONING_CAPACITY_INITIAL=4
# CLAUDE_REASONING_CAPACITY_FLOOR=2
# CLAUDE_REASONING_CAPACITY_CEILING=8
# CLAUDE_REASONING_SCORING_RESERVE=1
# CODEX_REASONING_CAPACITY_INITIAL=4
# CODEX_REASONING_CAPACITY_FLOOR=2
# CODEX_REASONING_CAPACITY_CEILING=8
# CODEX_REASONING_SCORING_RESERVE=1
# How long a provider is skipped after an availability failure, escalating per failure (ms, each at
# most 600000).
# CLAUDE_REASONING_CIRCUIT_COOLDOWNS_MS=60000,120000,300000,600000
# CODEX_REASONING_CIRCUIT_COOLDOWNS_MS=60000,120000,300000,600000
# Wait between asking a cancelled or timed-out CLI call to stop and killing it (ms, at most 30000).
# REASONING_ATTEMPT_TERMINATION_GRACE_MS=2000

# --- Audio -----------------------------------------------------------------------------------------
# Text-to-speech model for new Speaking and Listening Sets.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Clips synthesized at once across the whole server (a positive integer; anything else fails boot).
# Each one is a paid call; raise it to re-render many Sets faster.
# TTS_CONCURRENCY=1
# Model for the OpenAI text-to-speech path. No current renderer uses it: both render with Gemini.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Server and storage ----------------------------------------------------------------------------
# API port. The client's /api proxy reads the same setting.
# PORT=8787
# Where the Set bank, media, recordings and database live. Defaults to data/ in this checkout. Use an
# absolute path, and leave the line commented rather than blank: a blank value means the server's
# working directory. (The line below is an example, not the default.)
# TOEFL_DATA_DIR=/absolute/path/to/data
# Days to keep local model-call diagnostics. Older rows are pruned at boot and once a day after, and
# the freed space is given back to the file system; 0 keeps everything.
# MODEL_CALL_RETENTION_DAYS=30
# Graceful shutdown: how long to wait for running jobs, for the diagnostic recorder to flush, and
# before the process exits (ms).
# SHUTDOWN_DRAIN_MS=30000
# SHUTDOWN_RECORDER_FLUSH_MS=5000
# SHUTDOWN_PROCESS_GRACE_MS=2000
